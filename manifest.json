{
    "manifest_version": 3,
    "name": "PhishGuard: Phishing Detector",
    "version": "1.0.2",
    "permissions": ["activeTab"],
    "host_permissions": [
        "https://www.virustotal.com/*"
    ],
    "description": "PhishGuard detection: Automated LLM-powered detection for fishing E-Mails." ,
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://mail.google.com/*", "https://outlook.live.com/*"],
        "js": ["content.js"]
      }
    ]
  }